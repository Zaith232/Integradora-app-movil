<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Perfil del músico"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnMore"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/mariachi"
                    app:layout_constraintTop_toTopOf="parent" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileImage"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_launcher_background"
                    app:civ_border_width="3dp"
                    app:civ_border_color="?attr/colorPrimary"
                    android:elevation="12dp"
                    app:layout_constraintTop_toBottomOf="@id/heroImage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="-45dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:layout_constraintTop_toBottomOf="@id/heroImage">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="56dp"
                        android:paddingBottom="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:id="@+id/artistName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando..."
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipVerified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Verificado"
                                android:textSize="11sp"
                                android:visibility="gone"
                                app:chipBackgroundColor="#E6F4EA"
                                android:textColor="#1A5C3A"
                                app:chipStrokeWidth="0dp"
                                app:chipMinHeight="24dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="📍 Cargando ubicación..."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_marginBottom="20dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_pill"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvHourlyRate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="por hora"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_pill"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvCoverageNotes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="cobertura"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_pill"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="valoración"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/btnTabDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Acerca de"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textColor="?attr/colorPrimary"
                                    android:paddingBottom="8dp" />

                                <View
                                    android:id="@+id/indicatorDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="?attr/colorPrimary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/btnTabContact"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Contacto"
                                    android:textSize="15sp"
                                    android:gravity="center"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:paddingBottom="8dp" />

                                <View
                                    android:id="@+id/indicatorContact"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="?attr/colorPrimary"
                                    android:visibility="invisible" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.3"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout
                            android:id="@+id/layoutDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cargando detalles..."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutContactInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvNoContact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Este músico no ha agregado información de contacto."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textStyle="italic"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📱 Teléfono: "
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />

                            <TextView
                                android:id="@+id/tvInstagram"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📸 Instagram: "
                                android:textColor="#E1306C"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />

                            <TextView
                                android:id="@+id/tvFacebook"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📘 Facebook: "
                                android:textColor="#1877F2"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />

                            <TextView
                                android:id="@+id/tvYoutube"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▶️ YouTube: "
                                android:textColor="#FF0000"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnContratar"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:text="Solicitar contratación"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="24dp"
                                app:icon="@drawable/ic_calendar"
                                app:iconGravity="textStart"
                                app:backgroundTint="?attr/colorPrimary"
                                app:elevation="2dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFav"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_favorite_border"
                                app:iconTint="?attr/colorPrimary"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1.5dp"
                                app:cornerRadius="24dp"
                                app:backgroundTint="@android:color/transparent" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/labelAvail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:text="Disponibilidad próxima"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintTop_toBottomOf="@id/profileCard"
                    app:layout_constraintStart_toStartOf="parent" />

                <HorizontalScrollView
                    android:id="@+id/scrollDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/labelAvail">

                    <LinearLayout
                        android:id="@+id/layoutChipsDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVerCalendario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Ver calendario →"
                            android:textSize="12sp"
                            app:chipBackgroundColor="?attr/colorSurfaceVariant"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:chipStrokeWidth="0dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/layoutMultimediaTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/scrollDates"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginHorizontal="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/btnTabPhotos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fotos"
                                android:gravity="center"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:paddingBottom="8dp" />

                            <View
                                android:id="@+id/indicatorPhotos"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:background="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/btnTabVideos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Videos"
                                android:gravity="center"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:paddingBottom="8dp" />

                            <View
                                android:id="@+id/indicatorVideos"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:background="?attr/colorPrimary"
                                android:visibility="invisible" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.3" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMultimedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/layoutMultimediaTabs" />

                <TextView
                    android:id="@+id/labelReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="32dp"
                    android:text="Reseñas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintTop_toBottomOf="@id/rvMultimedia"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvNoReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:text="Este músico aún no tiene reseñas. ¡Sé el primero en contratarlo!"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textStyle="italic"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/labelReviews" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/labelReviews" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>