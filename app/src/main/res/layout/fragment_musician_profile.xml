<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#26000000"
        android:elevation="0dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Perfil del músico"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnMore"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileImage"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:src="@drawable/ic_user_placeholder"
                    app:civ_border_width="4dp"
                    app:civ_border_color="?attr/colorPrimary"
                    android:elevation="16dp"
                    app:layout_constraintTop_toBottomOf="@id/heroImage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="-70dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_glass_stroke"
                    app:cardBackgroundColor="@color/md_glass_surface"
                    app:layout_constraintTop_toBottomOf="@id/heroImage">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="82dp"
                        android:paddingBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:id="@+id/artistName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando..."
                                android:textColor="@color/md_onSurface"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.01" />

                            <ImageView
                                android:id="@+id/chipVerified"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_star"
                                android:visibility="gone"
                                app:tint="#8B5CF6" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="Cargando ubicación..."
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="20dp"
                            android:gravity="center_vertical"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/md_onSurfaceVariant"
                            android:drawablePadding="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_marginBottom="20dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_glass_card"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvHourlyRate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="por hora"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_glass_card"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvCoverageNotes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="cobertura"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_glass_card"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tvRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="valoración"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/btnTabDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Acerca de"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:gravity="center"
                                    android:textColor="?attr/colorPrimary"
                                    android:paddingBottom="8dp" />

                                <View
                                    android:id="@+id/indicatorDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="?attr/colorPrimary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/btnTabContact"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Contacto"
                                    android:textSize="15sp"
                                    android:gravity="center"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:paddingBottom="8dp" />

                                <View
                                    android:id="@+id/indicatorContact"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="?attr/colorPrimary"
                                    android:visibility="invisible" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.3"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout
                            android:id="@+id/layoutDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cargando detalles..."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutContactInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvNoContact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Este músico no ha agregado información de contacto."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textStyle="italic"
                                android:visibility="gone" />

                            <!-- Tarjeta: Teléfono -->
                            <LinearLayout
                                android:id="@+id/tvPhone"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_glass_card"
                                android:layout_marginBottom="10dp"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_input"
                                    app:tint="?attr/colorPrimary" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Teléfono"
                                        android:textColor="@color/md_onSurfaceVariant"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvPhoneValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/md_onSurface"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Tarjeta: Instagram -->
                            <LinearLayout
                                android:id="@+id/tvInstagram"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_glass_card"
                                android:layout_marginBottom="10dp"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_person"
                                    app:tint="#E1306C" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Instagram"
                                        android:textColor="@color/md_onSurfaceVariant"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvInstagramValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#E1306C"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Tarjeta: Facebook -->
                            <LinearLayout
                                android:id="@+id/tvFacebook"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_glass_card"
                                android:layout_marginBottom="10dp"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_facebook"
                                    app:tint="#1877F2" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Facebook"
                                        android:textColor="@color/md_onSurfaceVariant"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvFacebookValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#1877F2"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Tarjeta: YouTube -->
                            <LinearLayout
                                android:id="@+id/tvYoutube"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_glass_card"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_music_note"
                                    app:tint="#FF0000" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="YouTube"
                                        android:textColor="@color/md_onSurfaceVariant"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvYoutubeValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#FF0000"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnContratar"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="10dp"
                                    android:text="Solicitar contratación"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="24dp"
                                    app:icon="@drawable/ic_calendar"
                                    app:iconGravity="textStart"
                                    app:strokeColor="@color/md_glass_stroke"
                                    app:strokeWidth="1dp"
                                    app:backgroundTint="?attr/colorPrimary"
                                    app:elevation="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFav"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_favorite_border"
                                app:iconTint="?attr/colorPrimary"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1.5dp"
                                app:cornerRadius="24dp"
                                app:backgroundTint="@android:color/transparent" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta de Disponibilidad -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scrollDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_glass_stroke"
                    app:cardBackgroundColor="@color/md_glass_surface"
                    app:layout_constraintTop_toBottomOf="@id/profileCard"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Encabezado con icono -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="?attr/colorPrimary"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Disponibilidad"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_onSurface" />

                        </LinearLayout>

                        <!-- Subtexto descriptivo -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consulta las fechas libres del músico y elige el mejor momento para tu evento."
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Chip de accion estilizado -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipVerCalendario"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Ver calendario"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_calendar"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:strokeColor="?attr/colorPrimary"
                            app:strokeWidth="1.5dp"
                            app:backgroundTint="@android:color/transparent"
                            android:textColor="?attr/colorPrimary"
                            app:elevation="0dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sección Multimedia con glassmorphism y tabs pill -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutMultimediaTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_glass_stroke"
                    app:cardBackgroundColor="@color/md_glass_surface"
                    app:layout_constraintTop_toBottomOf="@id/scrollDates"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header: Título + Tabs Pill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Galeria"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_onSurface" />

                            <!-- Tabs tipo pastilla -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:background="@drawable/bg_glass_card"
                                android:paddingHorizontal="4dp">

                                <TextView
                                    android:id="@+id/btnTabPhotos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="Fotos"
                                    android:gravity="center"
                                    android:paddingHorizontal="16dp"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnPrimary"
                                    android:background="@drawable/bg_primary_button" />

                                <TextView
                                    android:id="@+id/btnTabVideos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="Videos"
                                    android:gravity="center"
                                    android:paddingHorizontal="16dp"
                                    android:textSize="13sp"
                                    android:textColor="@color/md_onSurfaceVariant"
                                    android:background="@android:color/transparent" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Indicadores técnicos (ocultos, solo la lógica los usa) -->
                        <View
                            android:id="@+id/indicatorPhotos"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="visible" />

                        <View
                            android:id="@+id/indicatorVideos"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="invisible" />

                        <!-- RecyclerView de multimedia -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMultimedia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipToPadding="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/labelReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="32dp"
                    android:text="Reseñas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintTop_toBottomOf="@id/layoutMultimediaTabs"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvNoReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:text="Este músico aún no tiene reseñas. ¡Sé el primero en contratarlo!"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textStyle="italic"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/labelReviews" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/labelReviews" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>