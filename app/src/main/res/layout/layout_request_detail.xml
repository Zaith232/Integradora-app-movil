<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOutline"
        android:alpha="0.5" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detalle de Solicitud"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDetailMusician"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Músico: Nombre"
        android:textSize="16sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetailDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha: 31 Mar, 2026"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvDetailLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubicación: 36 poniente"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutCounterOffer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F3E8FF"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Respuesta del músico:"
            android:textStyle="bold"
            android:textColor="#6D28D9"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMusicianMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensaje del músico..."
            android:textColor="#4C1D95"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva tarifa propuesta:"
            android:textSize="12sp"
            android:textColor="#6D28D9"/>

        <TextView
            android:id="@+id/tvNewPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$8,000 MXN"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#7C3AED"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectOffer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Rechazar"
                android:textColor="#DC2626"
                app:strokeColor="#FCA5A5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptOffer"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Aceptar"
                app:backgroundTint="#7C3AED" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>