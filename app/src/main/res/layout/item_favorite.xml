<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/md_surface"
    app:strokeColor="@color/md_outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFav"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:background="@color/md_outline"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/txtNameFav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/md_onSurface"
            app:layout_constraintTop_toTopOf="@id/imgFav"
            app:layout_constraintStart_toEndOf="@id/imgFav"
            app:layout_constraintEnd_toStartOf="@id/btnRemoveFav"/>

        <TextView
            android:id="@+id/txtDetailsFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_onSurfaceVariant"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtNameFav"
            app:layout_constraintStart_toStartOf="@id/txtNameFav"/>

        <ImageButton
            android:id="@+id/btnRemoveFav"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_secondary_button"
            android:src="@drawable/ic_favorite"
            app:tint="?attr/colorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>